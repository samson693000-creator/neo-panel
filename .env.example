# Local install (python install.py) uses SQLite by default.
# Docker/VPS: copy these Postgres values and point DATABASE_URL at the db service.

POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=botdb
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=please_generate_a_long_random_secret_string
ENCRYPTION_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now_123

DOMAIN=localhost
ACME_EMAIL=admin@example.com

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://localhost:8080
HOST=127.0.0.1
PORT=8000
